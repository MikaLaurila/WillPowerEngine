{
  "format": "wpe.project",
  "version": 1,
  "name": "Racing Online",
  "start_scene": "scenes/main.scene",
  "font": "",
  "display": {
    "width": 320,
    "height": 240,
    "scale": 3,
    "vsync": true,
    "resizable": true,
    "fullscreen": false
  },
  "simulation": {
    "fixed_rate": 60,
    "max_steps": 8
  },
  "assets": {
    "max_texture_size": 0
  },
  "audio": {
    "master": 1,
    "effects": 1,
    "music": 1
  },
  "scripting": {
    "memory_limit_mb": 64,
    "time_limit_ms": 250
  },
  "network": {
    "port": 47810,
    "discovery_port": 47809,
    "max_players": 4,
    "timeout_ms": 5000,
    "tick_rate": 30,
    "interpolation_ms": 100
  },
  "prefabs": {},
  "input": {
    "keyboard_player": 1,
    "stick_deadzone": 0.2,
    "stick_outer": 0.95,
    "trigger_deadzone": 0.1,
    "press_threshold": 0.5,
    "actions": {
      "throttle": [
        {"key": "w"},
        {"key": "up"},
        {"pad_axis": "right_trigger"}
      ],
      "brake": [
        {"key": "s"},
        {"key": "down"},
        {"pad_axis": "left_trigger"}
      ],
      "steer": [
        {"key": "d"},
        {"key": "a", "scale": -1},
        {"key": "right"},
        {"key": "left", "scale": -1},
        {"pad_axis": "left_x"}
      ],
      "handbrake": [
        {"key": "space"},
        {"pad_button": "east"}
      ],
      "start": [
        {"key": "return"},
        {"pad_button": "start"}
      ],
      "leave": [
        {"key": "escape"},
        {"pad_button": "back"}
      ],
      "menu_up": [
        {"key": "up"},
        {"pad_button": "dpad_up"}
      ],
      "menu_down": [
        {"key": "down"},
        {"pad_button": "dpad_down"}
      ],
      "menu_select": [
        {"key": "return"},
        {"pad_button": "south"}
      ]
    }
  }
}
