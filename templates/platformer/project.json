{
  "format": "wpe.project",
  "version": 1,
  "name": "Platformer",
  "start_scene": "scenes/main.scene",
  "font": "",
  "display": {
    "width": 320,
    "height": 240,
    "scale": 3,
    "vsync": true,
    "resizable": true,
    "fullscreen": false
  },
  "simulation": {
    "fixed_rate": 60,
    "max_steps": 8
  },
  "assets": {
    "max_texture_size": 0
  },
  "audio": {
    "master": 1,
    "effects": 1,
    "music": 1
  },
  "scripting": {
    "memory_limit_mb": 64,
    "time_limit_ms": 250
  },
  "prefabs": {},
  "input": {
    "keyboard_player": 1,
    "stick_deadzone": 0.2,
    "stick_outer": 0.95,
    "trigger_deadzone": 0.1,
    "press_threshold": 0.5,
    "actions": {
      "move_x": [
        {"key": "d"},
        {"key": "a", "scale": -1},
        {"key": "right"},
        {"key": "left", "scale": -1},
        {"pad_axis": "left_x"},
        {"pad_button": "dpad_right"},
        {"pad_button": "dpad_left", "scale": -1}
      ],
      "jump": [
        {"key": "space"},
        {"key": "w"},
        {"key": "up"},
        {"pad_button": "south"}
      ],
      "restart": [
        {"key": "r"},
        {"pad_button": "back"}
      ]
    }
  }
}
