{
  "format": "wpe.project",
  "version": 1,
  "name": "WillPowerEngine Demo",
  "start_scene": "scenes/title.scene",
  "font": "fonts/small.png",
  "display": {
    "width": 320,
    "height": 240,
    "scale": 3,
    "vsync": true,
    "resizable": true,
    "fullscreen": false
  },
  "simulation": {
    "fixed_rate": 60,
    "max_steps": 8
  },
  "assets": {
    "max_texture_size": 256
  },
  "audio": {
    "master": 1,
    "effects": 1,
    "music": 0.7
  },
  "scripting": {
    "memory_limit_mb": 64,
    "time_limit_ms": 250
  },
  "prefabs": {
    "box": "meshes/box.prim",
    "crate": "meshes/crate.prim",
    "ball": "meshes/ball.prim",
    "figure": "meshes/RiggedFigure.glb"
  },
  "input": {
    "keyboard_player": 1,
    "stick_deadzone": 0.2,
    "stick_outer": 0.95,
    "trigger_deadzone": 0.1,
    "press_threshold": 0.5,
    "actions": {
      "move_x": [
        {"key": "d"},
        {"key": "a", "scale": -1},
        {"key": "right"},
        {"key": "left", "scale": -1},
        {"pad_axis": "left_x"},
        {"pad_button": "dpad_right"},
        {"pad_button": "dpad_left", "scale": -1}
      ],
      "move_y": [
        {"key": "w"},
        {"key": "s", "scale": -1},
        {"key": "up"},
        {"key": "down", "scale": -1},
        {"pad_axis": "left_y", "scale": -1},
        {"pad_button": "dpad_up"},
        {"pad_button": "dpad_down", "scale": -1}
      ],
      "look_x": [
        {"pad_axis": "right_x"}
      ],
      "look_y": [
        {"pad_axis": "right_y"}
      ],
      "jump": [
        {"key": "space"},
        {"pad_button": "south"}
      ],
      "fire": [
        {"mouse_button": "left"},
        {"key": "f"},
        {"pad_axis": "right_trigger"},
        {"pad_button": "west"}
      ],
      "spell": [
        {"key": "e"},
        {"pad_button": "left_shoulder"}
      ],
      "special": [
        {"key": "q"},
        {"pad_button": "right_shoulder"}
      ],
      "boost": [
        {"key": "lshift"},
        {"pad_axis": "left_trigger"},
        {"pad_button": "left_stick"}
      ],
      "rumble_test": [
        {"key": "t"},
        {"pad_button": "north"}
      ],
      "reset": [
        {"key": "r"},
        {"pad_button": "back"}
      ],
      "switch_scene": [
        {"key": "tab"},
        {"pad_button": "start"}
      ],
      "release_mouse": [
        {"key": "escape"}
      ]
    }
  }
}
