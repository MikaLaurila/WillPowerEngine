{
  "format": "wpe.scene",
  "version": 1,
  "environment": {
    "clear_color": [0.36, 0.45, 0.58],
    "ambient": [0.2, 0.21, 0.25],
    "fog": {"mode": "linear", "color": [0.36, 0.45, 0.58], "start": 22, "end": 55},
    "shadows": {"enabled": true, "map_size": 1024, "distance": 24},
    "postfx": [
      {"effect": "vignette", "strength": 0.35, "radius": 0.75},
      {"effect": "color_adjust", "brightness": 0, "contrast": 1.05, "saturation": 1.1}
    ],
    "music": {"path": "music/ambient.wav", "fade": 2}
  },
  "camera": 1,
  "entities": [
    {
      "id": 1,
      "name": "camera",
      "transform": {"position": [0, 4, 8]},
      "camera": {"fov": 65, "near": 0.1, "far": 120},
      "script": {"path": "scripts/follow_camera.luau", "properties": {"target": "player", "distance": 6.5}}
    },
    {
      "id": 2,
      "name": "sun",
      "transform": {"position": [0, 10, 0], "euler": [-52, 35, 0]},
      "light": {"type": "directional", "color": [1, 0.96, 0.88], "intensity": 0.85, "cast_shadows": true}
    },
    {
      "id": 3,
      "name": "ground",
      "mesh": {"model": "meshes/ground.prim"},
      "transform": {"position": [0, 0, 0]},
      "collider": {"shape": "box", "size": [60, 1, 60], "offset": [0, -0.5, 0], "friction": 0.8}
    },
    {
      "id": 4,
      "name": "player",
      "transform": {"position": [0, 1, 2]},
      "mesh": {"model": "meshes/player.prim"},
      "rigidbody": {"type": "dynamic", "lock_rotation": true, "linear_damping": 0.05, "continuous": true},
      "collider": {"shape": "sphere", "size": [0.5, 0.5, 0.5], "friction": 0.3, "density": 2},
      "script": {"path": "scripts/player.luau", "properties": {"speed": 6, "jump_speed": 6.5, "player": 1}}
    },
    {
      "id": 5,
      "name": "game",
      "script": {"path": "scripts/game.luau",
                 "properties": {"next_scene": "scenes/test_full.scene", "title": "WillPowerEngine demo"}}
    },
    {
      "id": 6,
      "name": "ramp",
      "transform": {"position": [7, 0.9, -3], "euler": [-14, 0, 0]},
      "mesh": {"model": "meshes/ramp.prim"},
      "collider": {"shape": "box", "size": [4, 0.4, 6]}
    },
    {
      "id": 7,
      "name": "pillar",
      "transform": {"position": [-6, 1.5, 3]},
      "mesh": {"model": "meshes/pillar.prim"},
      "collider": {"shape": "box", "size": [1, 3, 1]}
    },
    {
      "id": 8,
      "name": "pillar",
      "transform": {"position": [-8, 1.5, -6]},
      "mesh": {"model": "meshes/pillar.prim"},
      "collider": {"shape": "box", "size": [1, 3, 1]}
    },
    {
      "id": 9,
      "name": "crate",
      "transform": {"position": [3, 0.5, -1], "euler": [0, 20, 0]},
      "mesh": {"model": "meshes/crate.prim"},
      "rigidbody": {"type": "dynamic"},
      "collider": {"shape": "box", "size": [1, 1, 1], "density": 0.6}
    },
    {
      "id": 10,
      "name": "crate",
      "transform": {"position": [3.2, 1.5, -1.1], "euler": [0, -10, 0]},
      "mesh": {"model": "meshes/crate.prim"},
      "rigidbody": {"type": "dynamic"},
      "collider": {"shape": "box", "size": [1, 1, 1], "density": 0.6}
    },
    {
      "id": 11,
      "name": "crate",
      "transform": {"position": [4.2, 0.5, -0.6], "euler": [0, 45, 0]},
      "mesh": {"model": "meshes/crate.prim"},
      "rigidbody": {"type": "dynamic"},
      "collider": {"shape": "box", "size": [1, 1, 1], "density": 0.6}
    },
    {
      "id": 12,
      "name": "ball",
      "transform": {"position": [-2, 0.5, -3]},
      "mesh": {"model": "meshes/ball.prim"},
      "rigidbody": {"type": "dynamic", "angular_damping": 0.4},
      "collider": {"shape": "sphere", "size": [0.5, 0.5, 0.5], "restitution": 0.5, "density": 0.4}
    },
    {
      "id": 13,
      "name": "helmet",
      "transform": {"position": [-4, 1.6, -4]},
      "instance": {"model": "meshes/damaged_helmet.glb"},
      "rigidbody": {"type": "kinematic"},
      "collider": {"shape": "sphere", "size": [0.9, 0.9, 0.9]},
      "script": {"path": "scripts/spinner.luau", "properties": {"speed": 0.8}}
    },
    {
      "id": 14,
      "name": "figure",
      "transform": {"position": [5, 0, 4], "euler": [0, -40, 0]},
      "instance": {"model": "meshes/RiggedFigure.glb", "animation": 0, "play": true}
    },
    {
      "id": 15,
      "name": "zone",
      "transform": {"position": [-3, 0.02, 5]},
      "mesh": {"model": "meshes/zone.prim"},
      "collider": {"shape": "box", "size": [4, 2, 4], "offset": [0, 1, 0], "trigger": true},
      "script": {"path": "scripts/trigger_zone.luau", "properties": {"pitch": 1.2}}
    },
    {
      "id": 16,
      "name": "orbit light",
      "transform": {"position": [0, 1, 0]},
      "script": {"path": "scripts/orbit_light.luau", "properties": {"radius": 9, "speed": 0.35, "height": 1.5}}
    },
    {
      "id": 17,
      "name": "spot",
      "transform": {"position": [-4, 5, -4], "euler": [-90, 0, 0]},
      "light": {"type": "spot", "color": [1, 0.8, 0.5], "intensity": 2.5, "range": 9, "inner_cone": 18, "outer_cone": 28}
    }
  ]
}
